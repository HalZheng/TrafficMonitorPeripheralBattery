#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TrafficMonitorPeripheralBattery contributors"
            VALUE "FileDescription", "TrafficMonitor wireless peripheral battery plugin"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "PeripheralBatteryPlugin"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "PeripheralBatteryPlugin.dll"
            VALUE "ProductName", "TrafficMonitorPeripheralBattery"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "https://github.com/HalZheng/TrafficMonitorPeripheralBattery"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
